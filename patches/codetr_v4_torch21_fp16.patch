diff --git a/mmdet/models/losses/iou_loss.py b/mmdet/models/losses/iou_loss.py
index bf1ed04..0fad41b 100644
--- a/mmdet/models/losses/iou_loss.py
+++ b/mmdet/models/losses/iou_loss.py
@@ -112,7 +112,14 @@ def giou_loss(pred, target, eps=1e-7):
     Return:
         Tensor: Loss tensor.
     """
-    gious = bbox_overlaps(pred, target, mode='giou', is_aligned=True, eps=eps)
+    # Pixel-coordinate areas overflow float16 at HOD26 resolutions. Keep the
+    # geometry in float32 under autocast while preserving gradients to pred.
+    gious = bbox_overlaps(
+        pred.float(),
+        target.float(),
+        mode='giou',
+        is_aligned=True,
+        eps=eps)
     loss = 1 - gious
     return loss
 
